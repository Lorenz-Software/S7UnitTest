# Normalize repository text; working copies use Windows line endings.
* text=auto
*.md text eol=crlf
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf
*.scl text eol=crlf
*.xml text eol=crlf
*.json text eol=crlf
*.yaml text eol=crlf
*.yml text eol=crlf
.gitignore text eol=crlf
.gitattributes text eol=crlf

# Preserve the standalone skill's exact payload bytes for its package manifest.
skills/s7unittest-framework-authoring/** -text !eol whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Keep the packaged templates' existing final blank lines without repackaging.
skills/s7unittest-framework-authoring/assets/templates/*.scl whitespace=blank-at-eol,space-before-tab,cr-at-eol,-blank-at-eof

# The archived TIA project is the only agreed Git LFS product path.
Project/S7_UnitTest.zap21 filter=lfs diff=lfs merge=lfs -text
