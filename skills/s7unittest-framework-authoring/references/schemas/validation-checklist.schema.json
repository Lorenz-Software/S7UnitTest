{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://s7unittest.local/schemas/validation-checklist.schema.json",
  "title": "S7 UnitTest authoring validation checklist",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "skillVersion",
    "frameworkVersion",
    "contractVersions",
    "rules"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "#/$defs/version"
    },
    "skillVersion": {
      "$ref": "#/$defs/version"
    },
    "frameworkVersion": {
      "$ref": "#/$defs/version"
    },
    "contractVersions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/version"
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/rule"
      }
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "requirementId": {
      "type": "string",
      "pattern": "^[A-Z]+-[0-9]{3}$"
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "severity",
        "scope",
        "checkType",
        "requirement"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^SKILL-[0-9]{3}$"
        },
        "severity": {
          "enum": [
            "error",
            "warning"
          ]
        },
        "scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "run-control",
              "test-suite",
              "test-case",
              "preparation",
              "assertion",
              "catalog",
              "template"
            ]
          }
        },
        "checkType": {
          "enum": [
            "automated",
            "structural",
            "semantic",
            "manual-review"
          ]
        },
        "requirement": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "contractRequirements": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/requirementId"
          }
        }
      }
    }
  }
}
