{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://s7unittest.local/schemas/assertion-catalog.schema.json",
  "title": "S7 UnitTest Assertion selection catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "skillVersion",
    "frameworkVersion",
    "contractVersions",
    "assertions"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "#/$defs/version"
    },
    "skillVersion": {
      "$ref": "#/$defs/version"
    },
    "frameworkVersion": {
      "$ref": "#/$defs/version"
    },
    "contractVersions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/version"
      }
    },
    "assertions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assertion"
      }
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "requirementId": {
      "type": "string",
      "pattern": "^[A-Z]+-[0-9]{3}$"
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "section",
        "dataType",
        "purpose"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "section": {
          "enum": [
            "input",
            "output",
            "in-out",
            "return"
          ]
        },
        "dataType": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "defaultValue": {
          "type": [
            "string",
            "number",
            "integer",
            "boolean",
            "null"
          ]
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "distinction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blockName",
        "difference"
      ],
      "properties": {
        "blockName": {
          "type": "string",
          "minLength": 1
        },
        "difference": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blockName",
        "blockType",
        "family",
        "category",
        "valueTypes",
        "purpose",
        "condition",
        "evaluationModel",
        "useWhen",
        "distinguishFrom",
        "interface",
        "configurationErrors",
        "resultBehavior",
        "messageBehavior"
      ],
      "properties": {
        "blockName": {
          "type": "string",
          "minLength": 1
        },
        "blockType": {
          "const": "FB"
        },
        "family": {
          "type": "string",
          "pattern": "^Assert[A-Za-z0-9]+$"
        },
        "category": {
          "enum": [
            "equality",
            "classification",
            "ordering",
            "range",
            "tolerance",
            "bit",
            "mask",
            "change",
            "edge-count",
            "sequence",
            "array-content",
            "array-length",
            "token-count",
            "text"
          ]
        },
        "valueTypes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "condition": {
          "type": "string",
          "minLength": 1
        },
        "evaluationModel": {
          "enum": [
            "immediate",
            "cyclic",
            "evaluate-triggered",
            "stateful"
          ]
        },
        "useWhen": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "distinguishFrom": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/distinction"
          }
        },
        "interface": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/parameter"
          }
        },
        "configurationErrors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "resultBehavior": {
          "type": "string",
          "minLength": 1
        },
        "messageBehavior": {
          "type": "string",
          "minLength": 1
        },
        "contractRequirements": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/requirementId"
          }
        }
      }
    }
  }
}
